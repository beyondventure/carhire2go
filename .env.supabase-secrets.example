# Copy this to .env.supabase-secrets before running:
#   npm run supabase:cutover -- --set-secrets
#
# Do not include TARGET_* or client-side publishable keys here. Everything in this file is uploaded
# as an Edge Function secret.

FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST_or_LIVE_key_here
FLUTTERWAVE_WEBHOOK_SECRET=flutterwave_webhook_secret_here
VAPID_PUBLIC_KEY=web_push_vapid_public_key_here
VAPID_PRIVATE_KEY=web_push_vapid_private_key_here
VAPID_SUBJECT=mailto:support@instantryde.com
