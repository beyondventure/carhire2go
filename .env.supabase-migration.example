# Copy this to .env.supabase-migration when preparing the Lovable Cloud -> Supabase cutover.
# Do not commit the copied file.

TARGET_SUPABASE_PROJECT_REF=your_new_project_ref
TARGET_SUPABASE_URL=https://your_new_project_ref.supabase.co
TARGET_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Required only when running mutating cutover commands through scripts/supabase-cutover.mjs.
# Set this to the same value as TARGET_SUPABASE_PROJECT_REF immediately before deployment.
CONFIRM_SUPABASE_CUTOVER=your_new_project_ref

# Optional override for secrets upload.
SUPABASE_SECRETS_ENV_FILE=.env.supabase-secrets
