# Copy this to .env for local web development.

VITE_SUPABASE_URL=https://<new-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Optional: used by npm run migrate for direct Postgres migration runs.
# Prefer Supabase CLI migrations for production cutovers.
DATABASE_URL=postgresql://postgres:<password>@db.<new-project-ref>.supabase.co:5432/postgres
SUPABASE_DB_PASSWORD=your_database_password_here
